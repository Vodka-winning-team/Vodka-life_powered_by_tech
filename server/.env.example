# Copy this file to server/.env (same folder) and fill in the keys you have.
# server/.env is git-ignored: never commit real keys. Every key is optional: a missing key only
# switches that check off, and the server says which checks are on at GET /health.

# --- Live link checks ---
# Google Safe Browsing API v4 (Google Cloud console → enable "Safe Browsing API" → API key)
SAFE_BROWSING_KEY=
# abuse.ch URLhaus (free account at https://auth.abuse.ch → Auth-Key)
URLHAUS_AUTH_KEY=

# --- Phone number check (optional) ---
# IPQualityScore phone validation (free account → API key; about 1,000 free lookups a month)
IPQS_KEY=

# --- myt AI Cloud text-to-speech (Kreol read-aloud) ---
# From the myt console (aiconsole.myt.mu): API key, API root ending in /v1, and a voice id.
MYT_API_KEY=
MYT_BASE_URL=
MYT_VOICE=
MYT_MODEL=myt/myt_tts

# --- Settings (defaults are fine) ---
# Random secret used to hash reporter ids and message fingerprints. Set any long random string.
SERVER_SALT=
# Different phones that must report the same message before it counts as confirmed.
REPORT_CONFIRMATIONS=2
# Seconds the server may spend on live checks for one message.
INTEL_BUDGET_SECONDS=3
# Requests allowed per minute from one address.
RATE_LIMIT_PER_MINUTE=60
